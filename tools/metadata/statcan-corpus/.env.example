# Qdrant Vector Database Configuration
# Find your Cluster URL on the Qdrant Cloud dashboard (e.g. https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333)
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333

# Find or generate your API key on the Qdrant Cloud "API Keys" tab
QDRANT_API_KEY=your_qdrant_api_key_here

# Collection name as created in Qdrant Cloud
QDRANT_COLLECTION=modularsurvey

# Embedding vector dimension (matches collection configuration)
QDRANT_VECTOR_DIM=384
